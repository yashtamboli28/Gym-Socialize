# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM (e.g., Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/prarena?schema=public"

# CLOUDINARY: Media storage for lift proof videos and fitness profile pictures
# If not configured, PR Arena uses an automated high-fidelity local/mock storage engine
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AUTH & JWT
JWT_SECRET="prarena_super_secret_jwt_key_2025"
PORT=3000
